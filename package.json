{
  "name": "cvaiex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run storefronts:validate && astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "data:refresh": "node scripts/import-city.mjs",
    "sky:refresh": "node scripts/import-sky.mjs",
    "mall:photos": "node scripts/import-mall-media.mjs",
    "reference:walkthrough": "node scripts/import-walkthrough.mjs",
    "storefronts:validate": "node scripts/storefronts.mjs validate",
    "storefronts:replace": "node scripts/storefronts.mjs replace",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && cf deploy --prebuilt",
    "deploy:dry-run": "npm run build && cf deploy --prebuilt --dry-run",
    "deploy:wrangler": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.3.5",
    "three": "^0.180.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.180.0",
    "cf": "1.0.0-beta.7",
    "@cloudflare/config": "0.22.0",
    "@cloudflare/build-output-utils": "0.8.4",
    "wrangler": "4.145.0"
  }
}
