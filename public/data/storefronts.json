      { "title": "A street for people", "text": "Main Street’s pedestrian mall stretches across eight blocks, with brick paving and connected pedestrian side streets.", "source": "https://en.wikipedia.org/wiki/Downtown_Mall" },
      { "title": "A landscape with a history", "text": "Landscape architect Lawrence Halprin designed the pedestrian conversion of East Main Street in the 1970s.", "source": "https://en.wikipedia.org/wiki/Downtown_Mall" },
      { "title": "The arts on Main Street", "text": "The Paramount and Jefferson theaters are central gathering places, with the outdoor Ting Pavilion at the mall’s eastern end.", "source": "https://en.wikipedia.org/wiki/Downtown_Mall" }
