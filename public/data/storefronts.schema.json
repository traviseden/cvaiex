{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.cvaiex.org/data/storefronts.schema.json",
  "title": "Cville Downtown Mall storefront catalog",
  "type": "object",
  "required": ["schemaVersion", "revision", "updatedAt", "district", "businesses", "slots", "media"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "district": {
      "type": "object", "required": ["id", "name", "description", "layoutNote", "length", "sources", "facts"],
      "properties": {
        "id": { "const": "downtown-mall" }, "name": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" }, "layoutNote": { "$ref": "#/$defs/text" },
        "length": { "type": "number", "minimum": 40, "maximum": 2000 }, "sources": { "$ref": "#/$defs/sources" },
        "facts": { "type": "array", "items": { "type": "object", "required": ["title", "text", "source"], "properties": { "title": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/url" } } } }
        ,"streetscape": { "type": "object", "required": ["width", "treeOffset", "treeSpacing", "walkLane"], "properties": { "width": { "type": "number", "minimum": 24, "maximum": 80 }, "treeOffset": { "type": "number", "minimum": 0 }, "treeSpacing": { "type": "number", "minimum": 12, "maximum": 60 }, "walkLane": { "type": "number", "minimum": 0 } } }
      }
    },
    "landmarks": { "type": "array", "items": { "type": "object", "required": ["id", "name", "kind", "along", "x", "description", "source"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "kind": { "enum": ["pavilion", "chalkboard"] }, "along": { "type": "number", "minimum": 0 }, "x": { "type": "number" }, "description": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/url" } } } },
    "chalkboard": { "type": "object", "required": ["heading", "lines", "cheer", "editable", "artNote"], "properties": { "heading": { "$ref": "#/$defs/text" }, "lines": { "type": "array", "items": { "$ref": "#/$defs/text" } }, "cheer": { "$ref": "#/$defs/text" }, "editable": { "const": false }, "artNote": { "$ref": "#/$defs/text" } } },
    "musicVenues": { "type": "array", "items": { "type": "object", "required": ["id", "title", "verifiedAt", "source", "performers"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "verifiedAt": { "type": "string", "format": "date" }, "source": { "$ref": "#/$defs/url" }, "performers": { "type": "array", "items": { "type": "object", "required": ["name", "date", "source"], "properties": { "name": { "$ref": "#/$defs/text" }, "date": { "type": "string", "format": "date" }, "source": { "$ref": "#/$defs/url" }, "note": { "$ref": "#/$defs/text" } } } } } } },
    "businesses": { "type": "array", "items": {
      "type": "object", "required": ["id", "name", "category", "address", "website", "description", "aliases", "operatingStatus", "verifiedAt", "sources", "photoId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "category": { "$ref": "#/$defs/text" }, "address": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" },
        "website": { "$ref": "#/$defs/url" }, "aliases": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "operatingStatus": { "enum": ["listed", "closed", "unknown"] }, "verifiedAt": { "type": "string", "format": "date" },
        "sources": { "$ref": "#/$defs/sources" }, "photoId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    } },
    "slots": { "type": "array", "items": {
      "type": "object", "required": ["id", "address", "side", "along", "width", "height", "businessId", "appearance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "address": { "$ref": "#/$defs/text" }, "side": { "enum": ["north", "south"] },
        "along": { "type": "number", "minimum": 0 }, "width": { "type": "number", "minimum": 4, "maximum": 50 }, "height": { "type": "number", "minimum": 3, "maximum": 40 },
        "businessId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "appearance": { "type": "object", "required": ["brick", "trim", "accent", "awning"], "properties": { "brick": { "$ref": "#/$defs/color" }, "trim": { "$ref": "#/$defs/color" }, "accent": { "$ref": "#/$defs/color" }, "awning": { "type": "boolean" }, "facadeImageId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] } } }
      }
    } },
    "media": { "type": "array", "items": {
      "type": "object", "required": ["id", "src", "alt", "creator", "license", "licenseUrl", "source", "capturedAt", "changes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "src": { "type": "string", "pattern": "^/media/mall/[a-z0-9-]+\\.(jpg|png|webp)$" }, "fileTitle": { "type": "string" },
        "alt": { "$ref": "#/$defs/text" }, "creator": { "$ref": "#/$defs/text" }, "license": { "$ref": "#/$defs/text" }, "licenseUrl": { "$ref": "#/$defs/url" },
        "source": { "$ref": "#/$defs/url" }, "capturedAt": { "type": "string", "format": "date" }, "changes": { "$ref": "#/$defs/text" }
      }
    } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/url" } },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
